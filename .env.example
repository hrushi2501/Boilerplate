# ==============================================================================
# PRAVI AI - Hackathon Boilerplate Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# DO NOT commit real secrets to source control.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (https://dashboard.clerk.com)
# Replace with your actual Clerk keys from Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk"
CLERK_SECRET_KEY="sk_test_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database (Supabase PostgreSQL Connection Strings for Drizzle ORM)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Cloudinary (https://cloudinary.com/console)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Upstash Redis (https://console.upstash.com) - Optional fast/ephemeral cache & rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional AI Providers (for rapid integration during hackathons)
OPENAI_API_KEY="sk-placeholder"
ANTHROPIC_API_KEY="sk-ant-placeholder"
